#!/usr/bin/env sh
set -eu

echo "[pre-push] Running full Pillion verification suite..."
pnpm verify

if [ -n "${ANDROID_HOME:-}" ] && [ -x "android/gradlew" ] && command -v javac >/dev/null 2>&1; then
  echo "[pre-push] Running native Android unit tests..."
  (cd android && ./gradlew :pillion-native:testDebugUnitTest --no-daemon)
fi

echo "[pre-push] All checks passed."

