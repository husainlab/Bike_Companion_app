{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "env": {
          "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
          "ORG_GRADLE_PROJECT_expo.useLegacyPackaging": "true"
        }
      }
    },
    "preview-armv7": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "env": {
          "ORG_GRADLE_PROJECT_reactNativeArchitectures": "armeabi-v7a",
          "ORG_GRADLE_PROJECT_expo.useLegacyPackaging": "true"
        }
      }
    },
    "preview-x86_64": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "env": {
          "ORG_GRADLE_PROJECT_reactNativeArchitectures": "x86_64",
          "ORG_GRADLE_PROJECT_expo.useLegacyPackaging": "true"
        }
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "env": {
          "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
        }
      }
    }
  }
}

